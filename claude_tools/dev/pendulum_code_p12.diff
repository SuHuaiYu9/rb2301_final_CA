> def in_lane(points, L, y_lo, y_hi, line_x, depth):
>     '''True if any point is in the lane ahead of the robot: sideways from y_lo to y_hi, and from the robot's front
>     to `depth` past the pendulum line.'''
>     x, y = points[:, 0], points[:, 1]
>     return bool(np.any((x > L) & (x < line_x + depth) & (y >= y_lo) & (y <= y_hi)))
